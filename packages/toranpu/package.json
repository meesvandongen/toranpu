{
  "name": "toranpu",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/meesvandongen/toranpu.git"
  },
  "private": false,
  "source": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --sourcemap --clean",
    "test": "vitest --coverage",
    "coverage": "vitest run --coverage",
    "docs": "npx @mvd/tsmd"
  },
  "devDependencies": {
    "@mvd/tsmd": "^1.0.3",
    "@structured-types/api": "^3.46.12",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "docs": "./docs",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist",
    "docs"
  ]
}
